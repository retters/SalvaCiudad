/* Test window of phases 117 to 119: the stonecutter's window of the
   mockups. Only its own layout lives here; the window parts are in
   /window.rcss and the look in the active style. */

body
{
	position: absolute;
	left: 80dp;
	top: 140dp;
	width: 360dp;
	min-width: 280dp;
}

.hero
{
	position: relative;
	height: 128dp;
	text-align: center;
	border-radius: var(--row-radius);
	decorator: var(--thumb);
	background-color: var(--row);
}

.hero img
{
	height: 120dp;
	width: 120dp;
	margin-top: 4dp;
}

.hero .chip
{
	position: absolute;
	left: 8dp;
	bottom: 8dp;
}

.kv
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
	margin-top: 4dp;
}

.k
{
	flex: 1;
	font-size: var(--font-small);
	color: var(--dim);
}

.res
{
	width: 20dp;
	height: 20dp;
	margin-right: 6dp;
}

.v
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.value
{
	font-weight: bold;
	margin: 0 8dp;
}

.foot .ibtn
{
	margin-left: 6dp;
}

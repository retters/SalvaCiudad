/* Base rules for every document of the player's interface (phases 117 and
   119). RmlUi has no built-in style sheet: elements are inline unless a sheet
   says otherwise, so the block elements are declared here. The var() tokens
   take the active style's values (src/ui/rml/rml_style.h). */

body, div, p, h1, h2, h3, section, header, footer, handle
{
	display: block;
}

body
{
	font-family: var(--font);
	font-size: var(--font-size);
	font-weight: normal;
	color: var(--text);
}

img
{
	display: inline-block;
}

span
{
	display: inline;
}

/* Phase 127: what the keyboard moves through (Tab, the arrows, Enter), and
   where its focus is. Each style may draw the focus its own way. */
.btn, .row, .choice, .wbtn, .dbtn, .bitem, .cat, input
{
	tab-index: auto;
	nav: auto;
}

.btn:focus-visible, .row:focus-visible, .choice:focus-visible, .wbtn:focus-visible, .dbtn:focus-visible,
.bitem:focus-visible, .cat:focus-visible, input:focus-visible
{
	border-color: var(--accent);
	box-shadow: var(--accent) 0 0 0 2dp;
}

.btn.off
{
	tab-index: none;
}

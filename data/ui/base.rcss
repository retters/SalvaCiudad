/* Base rules for every document of the player's interface (phases 117 and
   119). RmlUi has no built-in style sheet: elements are inline unless a sheet
   says otherwise, so the block elements are declared here. The var() tokens
   take the active style's values (src/ui/rml/rml_style.h). */

body, div, p, h1, h2, h3, section, header, footer, handle
{
	display: block;
}

body
{
	font-family: var(--font);
	font-size: var(--font-size);
	font-weight: normal;
	color: var(--text);
}

img
{
	display: inline-block;
}

span
{
	display: inline;
}

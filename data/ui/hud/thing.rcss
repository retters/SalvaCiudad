/* The windows of things (phase 124): the rows src/game/thing_rows.cpp
   builds, over /window.rcss and /hud/hwin.rcss. */

.rows
{
	display: block;
}

.r
{
	display: block;
}

.line
{
	padding: 2dp 0;
}

.line.dim
{
	font-size: var(--font-small);
	color: var(--dim);
}

.line.accent
{
	color: var(--accent);
}

/* Its picture, with whether it works. */
.hero
{
	position: relative;
	height: 128dp;
	margin-bottom: 6dp;
	text-align: center;
	border-radius: var(--row-radius);
	decorator: var(--thumb);
	background-color: var(--row);
}

.hero img
{
	width: 120dp;
	height: 120dp;
	margin-top: 4dp;
}

.hero .chip
{
	position: absolute;
	left: 8dp;
	bottom: 8dp;
}

.meter
{
	height: 8dp;
	margin: 6dp 0;
	border-radius: 4dp;
	background-color: var(--meter);
}

.meter .fill
{
	height: 8dp;
	border-radius: 4dp;
	decorator: var(--switch-on);
}

/* Buttons sharing a row. */
.btns
{
	display: flex;
	flex-direction: row;
	margin-top: 6dp;
}

.btn
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex: 1;
	height: 32dp;
	margin-left: 6dp;
	padding: 0 8dp;
	border-radius: var(--btn-radius);
	border: 1dp var(--btn-border);
	background-color: var(--btn);
	box-shadow: var(--btn-shadow);
	font-size: var(--font-small);
	white-space: nowrap;
	overflow: hidden;
}

.btns .btn:first-child
{
	margin-left: 0;
}

.btn:hover
{
	background-color: var(--btn-hover);
}

.btn.on
{
	background-color: var(--btn-on);
	color: var(--btn-on-text);
}

.btn img
{
	width: 18dp;
	height: 18dp;
	image-color: var(--icon);
}

.btn span
{
	margin-left: 0;
}

.btn img + span
{
	margin-left: 6dp;
}

.btn.on img
{
	image-color: var(--btn-on-text);
}

.btn.square
{
	flex: 0 0 auto;
	width: 32dp;
	padding: 0;
}

.btn.danger
{
	color: var(--bad);
}

.btn.danger img
{
	image-color: var(--bad);
}

.btn.danger:hover
{
	background-color: var(--bad-soft);
}

.btn.off, .btn.off:hover
{
	opacity: 0.5;
	color: var(--dim);
	background-color: var(--btn);
	box-shadow: none;
}

.btn.off img
{
	image-color: var(--dim);
}

/* A label with its buttons on the right. */
.kv
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 34dp;
	margin-top: 4dp;
}

.kv .k
{
	flex: 1;
	padding-right: 8dp;
}

.kv.locked .k
{
	color: var(--dim);
}

.kv .v
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.kv .btn
{
	flex: 0 0 auto;
	min-width: 32dp;
}

/* People: a link each to its own window; more than five scroll. */
.people
{
	max-height: 230dp;
	overflow-y: auto;
}

.people .row
{
	margin-top: 4dp;
	padding: 3dp 8dp;
}

.people .avatar
{
	width: 34dp;
	height: 34dp;
}

.people .who
{
	flex: 1;
}

.people scrollbarvertical
{
	width: 6dp;
	margin-left: 4dp;
}

.people scrollbarvertical sliderbar
{
	border-radius: 3dp;
	background-color: var(--switch-off);
}

.section.dim
{
	margin-top: 10dp;
	font-weight: normal;
	color: var(--dim);
}

/* The automatic trade's sliders. */
input.slider
{
	display: block;
	width: 100%;
	height: 22dp;
	margin-bottom: 4dp;
}

input.slider slidertrack
{
	height: 6dp;
	margin-top: 8dp;
	border-radius: 3dp;
	background-color: var(--meter);
}

input.slider sliderbar
{
	width: 16dp;
	height: 16dp;
	margin-top: 3dp;
	border-radius: 8dp;
	decorator: var(--switch-on);
}

input.slider sliderarrowdec, input.slider sliderarrowinc
{
	width: 0;
	height: 0;
}

input.slider:disabled
{
	opacity: 0.4;
}

/* Phase 125: the panels (hud/panel.rml), placed by the game. */
body.hpanel
{
	position: absolute;
	pointer-events: auto;
}

.ptitle
{
	padding: 2dp 0 6dp;
	font-size: var(--title-size);
	font-weight: var(--title-weight);
	color: var(--title-text);
}

.para
{
	display: block;
	padding: 2dp 0 4dp;
}

.line.bad
{
	color: var(--bad);
}

.line.night
{
	color: var(--info);
}

.kv.accent .k
{
	color: var(--accent);
}

/* A villager's needs. */
.meter.bad .fill
{
	decorator: none;
	background-color: var(--bad);
}

.meter.food .fill
{
	decorator: none;
	background-color: #e0a33c;
}

.meter.warm .fill
{
	decorator: none;
	background-color: #e08a3c;
}

.meter.health .fill
{
	decorator: none;
	background-color: #6faf5a;
}

.meter.energy .fill
{
	decorator: none;
	background-color: #7fb0e0;
}

/* A text field (a villager's new name). */
input.field
{
	display: block;
	width: 100%;
	height: 32dp;
	margin-top: 6dp;
	padding: 6dp 10dp;
	box-sizing: border-box;
	border-radius: var(--btn-radius);
	border: 1dp var(--btn-border);
	background-color: var(--row);
	cursor: text;
}

input.field:focus
{
	border-color: var(--accent);
}

/* The trade window's world map: a square per map, caravans on the way. */
.world
{
	position: relative;
	width: 150dp;
	height: 150dp;
	margin: 4dp auto 8dp;
}

.wcell
{
	position: absolute;
	box-sizing: border-box;
	border: 2dp transparent;
	border-radius: 4dp;
	background-color: #5f7f3f;
	text-align: center;
	font-size: var(--font-small);
	color: #ffffff;
}

.wcell.sea
{
	background-color: #2a4a66;
}

.wcell.mine
{
	background-color: var(--accent);
}

.caravan
{
	position: absolute;
	width: 6dp;
	height: 6dp;
	margin: -3dp 0 0 -3dp;
	border-radius: 3dp;
	background-color: #e8c45a;
}

/* Phase 126: a menu screen, over the veil. */
body.hpanel.screen
{
	overflow-y: auto;
}

.hpanel.screen .ptitle
{
	font-size: var(--title-size);
	padding-bottom: 10dp;
}

/* Phase 126: a stepper's value between its arrows, as the menus show it. */
.kv .val
{
	min-width: 160dp;
	padding: 0 8dp;
	text-align: center;
}

.kv.wide .k
{
	flex: 0 0 42%;
}

.kv.wide .v
{
	flex: 1;
	justify-content: flex-end;
}

.kv.wide .val
{
	flex: 1;
}

.btns.tabs .btn
{
	height: 36dp;
}

.r.notice .kv, .kv.notice
{
	padding: 8dp 10dp;
	border-radius: var(--row-radius);
	background-color: var(--bad-soft);
}

.btns.big .btn
{
	height: 44dp;
}

.swatches
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
	padding: 0 8dp;
	border-radius: var(--row-radius);
}

.swatch
{
	width: 22dp;
	height: 22dp;
	margin-right: 8dp;
	border-radius: 6dp;
}

body.hpanel.screen scrollbarvertical
{
	width: 8dp;
}

body.hpanel.screen scrollbarvertical sliderbar
{
	border-radius: 4dp;
	background-color: var(--switch-off);
}

.btns.modbar .btn
{
	flex: 0 0 auto;
	min-width: 32dp;
}

/* The lobby's seats and this player's color. */
.seats
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 8dp;
}

.seat
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 48%;
	height: 36dp;
	margin: 0 1% 6dp;
	padding: 0 8dp;
	border-radius: var(--row-radius);
	background-color: var(--row);
}

.seat .who
{
	flex: 1;
}

.seat .state
{
	font-size: var(--font-small);
	color: var(--dim);
}

.seat .state.on
{
	color: var(--accent);
}

.btn.colorpick
{
	justify-content: flex-start;
	margin: 6dp 0 0;
}

/* The new game's map preview. */
.preview
{
	width: 256dp;
	height: 256dp;
	margin: 8dp auto 4dp;
	border-radius: 8dp;
	background-color: var(--row);
	text-align: center;
}

.preview img
{
	width: 256dp;
	height: 256dp;
	border-radius: 8dp;
}

.preview img.old
{
	opacity: 0.55;
}

.preview p
{
	padding: 100dp 16dp 0;
	color: var(--dim);
}

.para.center
{
	text-align: center;
}

.btns.checks .btn
{
	justify-content: flex-start;
}

/* Headings inside panels (the windows have theirs in hwin.rcss). */
.hpanel .section
{
	margin-top: 12dp;
	padding-bottom: 4dp;
	font-weight: bold;
	color: var(--accent);
	border-bottom: 1dp var(--sep);
}

.kv.keys .btn
{
	width: 150dp;
	margin-left: 6dp;
}

.btns.big .btn
{
	font-size: var(--font-size);
}

<rml>
<head>
	<title>HUD: placing</title>
	<link type="text/rcss" href="/base.rcss"/>
	<link type="text/rcss" href="/window.rcss"/>
	<link type="text/rcss" href="/style.rcss"/>
	<link type="text/rcss" href="hud.rcss"/>
</head>
<!-- What placing a building, tracing a line or marking a field says
     (phase 122): over the build bar. Data model "hint". -->
<body id="hint" data-model="hint" style="left: 0; right: 0; display: flex; flex-direction: row; justify-content: center;">
	<div class="pill" data-if="shown" style="height: auto; min-height: 34dp; padding: 4dp 16dp;" data-class-bad="bad"><span>{{text}}</span></div>
</body>
</rml>

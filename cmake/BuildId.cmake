# Writes a header with an identifier of the source code this build comes
# from: a hash of every file under src/ (decision D-3321). Two builds from
# the same sources get the same identifier on any computer; any change to
# the code gives another one, so the lobby can tell builds apart even when
# the version number is the same.
# Usage: cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P BuildId.cmake
file(GLOB_RECURSE files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/src/*")
list(SORT files)
set(listing "")
foreach(f IN LISTS files)
    file(SHA256 "${SOURCE_DIR}/${f}" h)
    string(APPEND listing "${f} ${h}\n")
endforeach()
string(SHA256 id "${listing}")
string(SUBSTRING "${id}" 0 12 id)
# Only a new identifier touches the header, so an unchanged one does not
# rebuild what includes it.
file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/BuildId.cmake. Do not edit.
#pragma once

#define SC_BUILD_ID \"${id}\"
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
